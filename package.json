{
  "name": "lexiflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal English reading & expression learning Chrome extension",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "release:verify": "node scripts/release-verify/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@floating-ui/react": "^0.27.0",
    "@mozilla/readability": "^0.5.0",
    "@webext-core/messaging": "^3.0.0",
    "ai": "^7.0.0",
    "dexie": "^4.0.0",
    "dexie-export-import": "^4.0.0",
    "minisearch": "^7.0.0",
    "react": "^18.3.1",
    "react-aria-components": "^1.0.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "ts-fsrs": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/chrome": "^0.0.260",
    "@types/mozilla-readability": "^0.2.1",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "msw": "^2.0.0",
    "papaparse": "^5.4.0",
    "playwright": "^1.45.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0",
    "wxt": "^0.20.0"
  }
}
