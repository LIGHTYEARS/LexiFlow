# LexiFlow Environment Configuration
# Copy to .env and fill in values for local development/testing.

# LiteLLM connection (used by integration tests and manual testing)
# Not used in unit tests. Never commit actual keys.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-xxxxx

# Model names for different tasks
LITELLM_MODEL_EXPLAIN=gpt-4o-mini
LITELLM_MODEL_ANALYZE=gpt-4o-mini
LITELLM_MODEL_PRACTICE=gpt-4o-mini
